@theme ".config/rofi/configs/shared.rasi"
?import ".cache/rofi-rounding.rasi"

configuration {
	show-icons: true;
    font: "Rubik Bold 12";
}

#window {
    background-color: #161618;
}

* {
    background: #161618;
}

inputbar {
    border: 2px solid;
    border-color: @active-background;
    padding: 4px;
    border-radius: 32px;
}

element {
    background-color: #161618;
    border-radius: 32px;
    text-color: @normal-background;
}

element-text {
    vertical-align: 0.5;
}

element-icon {
    size: 32;
}

listview {
    background-color: #161618;
    lines: 12;
}
