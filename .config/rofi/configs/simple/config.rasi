@theme ".config/rofi/configs/shared.rasi"
?import ".cache/rofi/rounding.rasi"

configuration {
	show-icons: true;
	display-drun: "Launch";
}

inputbar {
    border: 2px solid;
    border-color: @active-background;
    padding: 4px;
    border-radius: 8px;
}

element {
    border-radius: 8px;
    text-color: @normal-background;
}

element-icon {
    size: 48;
}

listview {
    lines: 8;
}

element selected.normal {
    text-color: @background;
}
