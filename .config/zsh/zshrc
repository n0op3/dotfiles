source ~/.config/zsh/common

# --- Env ---
export TMUX_SOCKET_NAME="tmux-$RANDOM"
export EDITOR=${SSH_CONNECTION:+vim}
    : ${EDITOR:=nvim}
export VISUAL=$EDITOR
export MANPAGER='nvim +Man!'
export FZF_DEFAULT_OPTS="--cycle"

setopt autocd interactive_comments

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=$HISTSIZE
setopt sharehistory hist_ignore_space hist_ignore_all_dups hist_reduce_blanks

# --- Completion ---
zstyle ':completion:*' matcher-list \
    'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
autoload -Uz compinit
_zd=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump
[[ -d ${_zd:h} ]] || mkdir -p ${_zd:h}
if [[ -n $_zd(#qN.mh-24) ]]; then compinit -C -d $_zd; else compinit -d $_zd; fi
unset _zd

# --- Cached tool init ---
_cache_init() {
    local name=$1; shift
    local bin=${commands[$1]:A}
    [[ -n $bin ]] || return
    local f=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/init-$name-${bin//\//_}.zsh
    if [[ ! -s $f ]]; then
        mkdir -p ${f:h}
        "$@" >| $f
    fi
    source $f
}
_cache_init starship starship init zsh --print-full-init
_cache_init zoxide   zoxide init --cmd cd zsh
_cache_init fzf      fzf --zsh

# --- Keybindings ---
bindkey -v
KEYTIMEOUT=1
bindkey -M viins '^p' history-search-backward
bindkey -M viins '^n' history-search-forward

sudo-toggle() {
    [[ -z $BUFFER ]] && BUFFER=$(fc -ln -1)
    if [[ $BUFFER == sudo\ * ]]; then
        BUFFER=${BUFFER#sudo }; (( CURSOR = CURSOR > 5 ? CURSOR - 5 : 0 ))
    else
        BUFFER="sudo $BUFFER"; (( CURSOR += 5 ))
    fi
}
zle -N sudo-toggle
bindkey -M vicmd '\e' sudo-toggle

# --- Plugins (deferred) ---
ZINIT_HOME=$HOME/.local/share/zinit/zinit.git
[[ -r $ZINIT_HOME/zinit.zsh ]] || {
    mkdir -p ${ZINIT_HOME:h}
    git clone https://github.com/zdharma-continuum/zinit $ZINIT_HOME
}
source $ZINIT_HOME/zinit.zsh

zinit wait lucid for \
    Aloxaf/fzf-tab \
    atload"_zsh_autosuggest_start" zsh-users/zsh-autosuggestions \
    zdharma-continuum/fast-syntax-highlighting

y() {
    local tmp cwd
    tmp=$(mktemp -t "yazi-cwd.XXXXXX")
    yazi "$@" --cwd-file="$tmp"
    cwd=$(<"$tmp")
    [[ -n $cwd && $cwd != $PWD ]] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

[[ -r ~/.config/zsh/functions ]] && source ~/.config/zsh/functions
[[ -r ~/.config/zsh/aliases ]] && source ~/.config/zsh/aliases
startup
