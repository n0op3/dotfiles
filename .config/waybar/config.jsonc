{
    "layer": "top",
    "spacing": 16,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "cpu",
        "clock",
        "memory"
    ],
    "modules-right": [
        "pulseaudio",
        "battery"
    ],
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-time": "{H} hr {M} min",
        "format-icons": [
            "󰂎",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰉁 {capacity}%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "{icon} {volume}%",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "default-muted": "󰝟",
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "headset": "󰋎",
            "headset-muted": "󰋐"
        }
    },
    "clock": {
        "format": "{:%H:%M %d-%m}",
        "interval": 1
    }
}
