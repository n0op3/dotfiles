{
    "layer": "top",
    "margin": 4,
    "height": 40,
    "spacing": 16,
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "cpu",
        "clock",
        "memory"
    ],
    "modules-right": [
        "network",
        "tray",
        "pulseaudio",
        "battery"
    ],
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon}",
        "format-time": "{H} hr {M} min",
        "format-icons": [
            "󰂎",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "format-charging": "󰉁 {capacity}%"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "{icon} {volume}%",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "default-muted": "󰝟",
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "headset": "󰋎",
            "headset-muted": "󰋐"
        }
    },
    "clock": {
        "format": " {:%H:%M %d-%m}",
        "interval": 1
    },
    "network": {
        "format-wifi": "󰖩 {icon}({signalStrength}%)  {essid}",
        "format-disabled": "no connection",
        "format-icons": [
            "󰢿 ",
            "󰢼 ",
            "󰢽 ",
            "󰢾 "
        ]
    },
    "cpu": {
        "format": "{icon}  {usage}%",
        "format-icons": [
            " ",
            "  "
        ],
        "interval": 5
    },
    "memory": {
        "format": "{icon}  {percentage}%",
        "format-icons": [
            " ",
            " ",
            "  "
        ],
        "interval": 5
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "active": "󰻃 "
        },
        "persistent-workspaces": {
            "*": 4
        }
    }
}
